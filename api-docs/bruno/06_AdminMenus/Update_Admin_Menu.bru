meta {
  name: Update Admin Menu
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/api/v1/menus/:menuHash
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
{
  "title": "Modul Keuangan Pusat",
  "icon": "ph-duotone ph-bank"
}
}
