meta {
  name: Generate Presigned Download URL
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/storage/presign
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
{
  "key": "Dokumen-2026/laporan-final.pdf",
  "ttl": 300
}
}
