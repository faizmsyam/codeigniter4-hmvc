meta {
  name: Update Email SMTP Settings
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/v1/settings/email
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
{
  "protocol": "smtp",
  "smtp_host": "smtp.mailtrap.io",
  "smtp_port": 2525,
  "smtp_user": "username",
  "smtp_pass": "password",
  "smtp_crypto": "tls",
  "from_email": "noreply@fmsprojects.my.id",
  "from_name": "FMS Notification"
}
}
