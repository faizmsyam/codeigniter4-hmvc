meta {
  name: Create API Key
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/settings/api-keys
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
{
  "name": "Mobile Client Integration",
  "rate_limit": 60,
  "expires_at": null
}
}
