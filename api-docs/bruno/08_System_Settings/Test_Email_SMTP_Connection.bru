meta {
  name: Test Email SMTP Connection
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/settings/email/test
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
{
  "test_email": "admin@example.com"
}
}
