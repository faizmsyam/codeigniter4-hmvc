meta {
  name: Update Auth Security Settings
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/settings/auth
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
{
  "session_timeout_minutes": 60,
  "max_login_attempts": 5,
  "lockout_time_minutes": 15
}
}
