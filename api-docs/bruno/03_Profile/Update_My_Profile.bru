meta {
  name: Update My Profile
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/api/v1/profile
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

