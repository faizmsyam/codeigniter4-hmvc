meta {
  name: Change Password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/profile/change-password
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
{
  "old_password": "{{adminPassword}}",
  "new_password": "NewPassword12345!",
  "confirm_password": "NewPassword12345!"
}
}
