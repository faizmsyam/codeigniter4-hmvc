meta {
  name: Update Brand Settings
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/api/v1/brand
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
{
  "name": "FMS App Starter Enterprise",
  "tagline": "Modern High-Performance CI4 HMVC",
  "company": "FMS Technologies",
  "color_backend_primary": "#0D9488"
}
}
